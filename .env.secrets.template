# Copy to .env.secrets and change all values. Never commit .env.secrets.

# API key (exactly 32 characters, shared by all services to sign and verify JWTs)
UNITE_API_KEY=Defautl32BitApiKeyHasToBeChanged

# Portal administrator (root user)
UNITE_ADMIN_USER=admin@unite.net
UNITE_ADMIN_PASSWORD=Long-pa55w0rd

# GitHub credentials (clone sources and install packages when building from source)
UNITE_GITHUB_USER=root
UNITE_GITHUB_TOKEN=Long-t0ken

# PostgreSQL credentials
UNITE_PGSQL_USER=root
UNITE_PGSQL_PASSWORD=Long-pa55w0rd

# MySQL credentials (Ensembl data)
# The user is always root: the MySQL image only lets you set the root password.
UNITE_MYSQL_USER=root
UNITE_MYSQL_PASSWORD=Long-pa55w0rd

# MongoDB credentials
UNITE_MONGO_USER=root
UNITE_MONGO_PASSWORD=Long-pa55w0rd

# Elasticsearch credentials
# The user is always elastic: ELASTIC_PASSWORD sets the password of this built-in user.
# Kibana connects as the built-in kibana_system user with the same password.
UNITE_ELASTIC_USER=elastic
UNITE_ELASTIC_PASSWORD=Long-pa55w0rd
