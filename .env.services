# Source locations of UNITE services for build.remote.sh and build.local.sh.
# Read by the scripts in scripts/app/ (shell syntax, not used by Docker Compose).
# Override single services in .env.services.local (gitignored).

# Prefixes used to build the defaults below.
# Set your local prefix in your shell profile: export UNITE_SOURCE_PATH_PREFIX=...
UNITE_SOURCE_PATH_PREFIX=${UNITE_SOURCE_PATH_PREFIX:-/path/to/unite/repositories}
UNITE_SOURCE_URL_PREFIX=${UNITE_SOURCE_URL_PREFIX:-https://github.com/dkfz-unite}

# <KEY>_NAME    display name (optional, defaults to the key)
# <KEY>_PATH    local source folder (build.local.sh)
# <KEY>_URL     repository to clone (build.remote.sh)
# <KEY>_BRANCH  branch to clone (optional, empty = repository default)

UNITE_PORTAL_NAME="UNITE Web application"
UNITE_PORTAL_PATH=${UNITE_SOURCE_PATH_PREFIX}/unite
UNITE_PORTAL_URL=${UNITE_SOURCE_URL_PREFIX}/unite.git
UNITE_PORTAL_BRANCH=

UNITE_IDENTITY_NAME="UNITE Identity service"
UNITE_IDENTITY_PATH=${UNITE_SOURCE_PATH_PREFIX}/unite-identity
UNITE_IDENTITY_URL=${UNITE_SOURCE_URL_PREFIX}/unite-identity.git
