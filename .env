# Portal host
UNITE_INSTANCE_HOST=http://localhost
# Whether the instance of the portal is public or private
UNITE_INSTANCE_PUBLIC=false
# Legal notice URL
UNITE_LEGAL_NOTICE_URL=
# Privacy policy URL
UNITE_PRIVACY_POLICY_URL=
# Data retention period in days (inactive non-root accounts and their data are deleted after it)
UNITE_RETENTION_PERIOD=90
# Password reset token lifetime in minutes
UNITE_RESET_TTL=30
# Reference genome build of DNA and bulk RNA data (GRCh37 or GRCh38), chosen once per installation
# Ensembl database and VEP cache are downloaded for this build
UNITE_GENOME_BUILD=GRCh37


# Environment service locations
UNITE_PGSQL_HOST=pgsql.unite.net
UNITE_PGSQL_PORT=5432
UNITE_MYSQL_HOST=mysql.unite.net
UNITE_MYSQL_PORT=3306
UNITE_MONGO_HOST=mongo.unite.net
UNITE_MONGO_PORT=27017
UNITE_ELASTIC_HOST=http://es.unite.net:9200
